{#
 # Bulk add accessories — native GLPI form chrome (same as dropdown/item forms).
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="asset">
    {{ include('components/form/header.html.twig') }}

    <div class="card-body row">
        {{ fields.textField(
            'name',
            '',
            __('Name'),
            field_options
        ) }}

        {{ fields.dropdownArrayField(
            'itemtype',
            default_type,
            type_choices,
            __('Equipment type', 'auchanassettracker'),
            field_options|merge({'required': true})
        ) }}

        {{ fields.dropdownField(
            'Manufacturer',
            'manufacturers_id',
            0,
            __('Manufacturer'),
            field_options
        ) }}

        {{ fields.htmlField(
            'models_id',
            model_dropdown,
            __('Model'),
            field_options
        ) }}

        {{ fields.numberField(
            'quantity',
            1,
            __('Quantity', 'auchanassettracker'),
            field_options|merge({
                'required': true,
                'min': 1,
                'max': 500,
                'step': 1
            })
        ) }}

        {% if scope is not null %}
            {% set location_html %}
                {{ location_label|raw }}
                <input type="hidden" name="locations_id" value="{{ scope }}" />
                <div class="form-text">{{ scope_help }}</div>
            {% endset %}
            {{ fields.htmlField(
                'locations_id',
                location_html,
                __('Location'),
                field_options|merge({'required': true})
            ) }}
        {% else %}
            {{ fields.dropdownField(
                'Location',
                'locations_id',
                0,
                __('Location'),
                field_options|merge({'required': true})
            ) }}
        {% endif %}

        {{ fields.htmlField(
            'plugin_auchanassettracker_containers_id',
            container_dropdown,
            __('Physical container', 'auchanassettracker'),
            field_options|merge({
                'required': true
            })
        ) }}

        {{ fields.textareaField(
            'notes',
            '',
            __('Notes'),
            field_options|merge({
                'full_width': true,
                'rows': 3
            })
        ) }}

        <input type="hidden" name="bulk_add" value="1" />
    </div>

    {{ include('components/form/buttons.html.twig') }}
</div>
